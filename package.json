{
  "name": "dotmd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "TMPDIR=.tmp PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:headed": "TMPDIR=.tmp PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --headed",
    "test:e2e:install": "TMPDIR=.tmp PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "test:e2e:mock-supabase": "MOCK_SUPABASE_PORT=54321 bun test/e2e/mock-supabase.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.1",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "15.5.18",
    "next-safe-action": "8.5.2",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "radix-ui": "1.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@happy-dom/global-registrator": "20.9.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "postcss": "8.5.15",
    "shadcn": "3.8.5",
    "supabase": "2.101.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
